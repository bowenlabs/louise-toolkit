{
  "name": "louise-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Louise Toolkit — a V8-native toolkit for building editable sites on Cloudflare Workers. Monorepo: the louise-toolkit library, its Astro adapter, the Starlight docs, and the sandbox.",
  "license": "MIT",
  "author": "BowenLabs",
  "type": "module",
  "scripts": {
    "build": "corepack pnpm run build:packages && corepack pnpm run build:sandbox && sh ./scripts/ci-build.sh",
    "build:packages": "corepack pnpm -C packages/louise run build && corepack pnpm -C packages/louise-astro run build",
    "build:sandbox": "vp run sandbox#build",
    "typecheck": "vp run louise#typecheck",
    "check": "vp run louise#check",
    "fmt:check": "vp fmt --check --ignore-path .oxfmtignore",
    "fmt": "vp fmt --ignore-path .oxfmtignore",
    "lint:astro": "biome lint .",
    "lint:astro:fix": "biome lint --write .",
    "lint:docs": "node --test scripts/ci/checks/copy-extract.test.mjs && node scripts/ci/checks/vale-ratchet.mjs",
    "lint:core": "node scripts/ci/checks/no-astro-in-core.mjs",
    "lint:names": "node scripts/ci/checks/no-client-names.mjs",
    "lint:facts": "node scripts/ci/checks/site-fact-literals.mjs",
    "lint:arch": "corepack pnpm --package=@ast-grep/cli@0.45.2 dlx ast-grep scan",
    "lint:solid": "corepack pnpm dlx --package=oxlint@1.73.0 --package=eslint-plugin-solid@0.17.0 oxlint packages/louise/src/client",
    "knip": "knip",
    "lint:release": "node scripts/ci/checks/release-tooling.mjs",
    "test": "vp run louise#test && vp run louise-astro#test",
    "dev": "vp run docs#dev",
    "changeset": "changeset",
    "release": "corepack pnpm run build:packages && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^3.0.1",
    "eslint-plugin-solid": "^0.17.0",
    "knip": "^6.34.0",
    "typescript": "^6.0.3",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
