{
  "name": "louise-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Louise Toolkit — a V8-native toolkit for building editable sites on Cloudflare Workers. Monorepo: the louise library plus the louisetoolkit.com marketing site and Starlight docs.",
  "license": "MIT",
  "author": "BowenLabs",
  "type": "module",
  "scripts": {
    "build": "sh ./scripts/ci-build.sh",
    "build:site": "vp run site#build",
    "typecheck": "vp run louise#typecheck",
    "check": "vp run louise#check",
    "fmt:check": "vp fmt --check --ignore-path .oxfmtignore",
    "fmt": "vp fmt --ignore-path .oxfmtignore",
    "lint:astro": "biome lint .",
    "lint:astro:fix": "biome lint --write .",
    "lint:docs": "corepack pnpm --package=@vvago/vale@3.17.1 dlx vale workers/docs/src/content/docs",
    "lint:core": "node scripts/ci/checks/no-astro-in-core.mjs",
    "lint:arch": "corepack pnpm --package=@ast-grep/cli@0.45.2 dlx ast-grep scan",
    "lint:solid": "corepack pnpm dlx --package=oxlint@1.73.0 --package=eslint-plugin-solid@0.14.5 oxlint packages/louise/src/client",
    "knip": "knip",
    "test": "vp run louise#test && vp run astroid#test",
    "dev": "vp run site#dev",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^2.31.1",
    "eslint-plugin-solid": "^0.14.5",
    "knip": "^5.88.1",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.13.0"
}
