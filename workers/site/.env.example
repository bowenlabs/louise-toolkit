# Local dev editor-gate config for `astro dev` — astro:env reads these from .env
# (copy to .env). In production these come from wrangler instead: OWNER_EMAIL from
# `vars` in wrangler.jsonc, and `wrangler secret put NAME` for the secret ones.
# (MEDIA_URL is a Worker `var`, not astro:env — see wrangler.jsonc.)
OWNER_EMAIL=editor@louisetoolkit.com
# Editor gate. Set a real value to sign in at /louise locally; left blank,
# anonymous browsing still works (the sign/verify paths just aren't exercised).
LOUISE_SESSION_SECRET=
LOUISE_EDITOR_PASSWORD=

# Astro's server-island encryption key (`pnpm exec astro create-key`).
#
# `<LouiseEditIsland server:defer>` is a server island, and Astro encrypts an
# island's props/export into the URL the browser fetches. Unset, Astro generates a
# NEW random key on every build — so HTML rendered by one build cannot have its
# island resolved by the next one, and the request 400s ("Encrypted
# componentExport value is invalid"). The editor chrome then silently doesn't
# appear for anyone holding a page from before the deploy.
#
# That matters here more than on most sites: every branch push is a production
# deploy, so the key rotates constantly. Set the SAME value in the Cloudflare
# Workers Builds environment (it is read at BUILD time, not at runtime) and keep
# it stable across deploys.
ASTRO_KEY=
