{
  "name": "@louise-toolkit/astro",
  "version": "0.1.0",
  "description": "Astro adapter for louise-toolkit: middleware, Actions, content-layer loaders, and the forms schema bridge.",
  "keywords": [
    "astro",
    "cloudflare",
    "cms",
    "louise",
    "louise-toolkit"
  ],
  "homepage": "https://louisetoolkit.com",
  "bugs": "https://github.com/bowenlabs/louise-toolkit/issues",
  "license": "MIT",
  "author": "BowenLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bowenlabs/louise-toolkit.git",
    "directory": "packages/louise-astro"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "check": "vp check",
    "prepublishOnly": "node ../../scripts/ci/checks/dist-present.mjs",
    "test": "vp test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "louise-toolkit": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "astro": "^7.2.9",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "astro": "^7.0.6"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
