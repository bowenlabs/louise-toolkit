{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import"],
  // eslint-plugin-solid, loaded as an oxlint JS plugin. The SolidJS reactivity
  // rules only make sense for the inline-edit client, so they're scoped to
  // src/client/** via the override below (not the framework-agnostic core).
  "jsPlugins": ["eslint-plugin-solid"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unsafe-function-type": "warn",
    "no-unassigned-vars": "off"
  },
  "overrides": [
    {
      "files": ["**/src/client/**/*.{ts,tsx}"],
      "rules": {
        "solid/reactivity": "warn",
        "solid/no-destructure": "warn",
        "solid/components-return-once": "warn",
        "solid/no-react-specific-props": "warn",
        "solid/no-react-deps": "warn",
        "solid/prefer-for": "warn",
        "solid/event-handlers": "warn",
        "solid/style-prop": "warn",
        "solid/no-innerhtml": "off",
        "solid/self-closing-comp": "warn",
        "solid/jsx-no-undef": "error",
        "solid/jsx-no-duplicate-props": "error"
      }
    },
    {
      // Accessibility, on the client's JSX (#600). oxlint's built-in jsx-a11y
      // plugin, limited to rules that don't assume React prop names, so a Solid
      // `class` or `onClick` reads the same as it does to the browser.
      "files": ["**/src/client/**/*.tsx"],
      "plugins": ["jsx-a11y"],
      "rules": {
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-proptypes": "error",
        "jsx-a11y/aria-role": "error",
        "jsx-a11y/aria-unsupported-elements": "error",
        "jsx-a11y/role-has-required-aria-props": "error",
        "jsx-a11y/role-supports-aria-props": "error",
        "jsx-a11y/no-autofocus": "error",
        "jsx-a11y/click-events-have-key-events": "error",
        "jsx-a11y/tabindex-no-positive": "error",
        "jsx-a11y/iframe-has-title": "error",
        "jsx-a11y/no-aria-hidden-on-focusable": "error",
        "jsx-a11y/no-redundant-roles": "error",
        // Off: it reads React's `htmlFor`, so every Solid `<label for>` fails.
        "jsx-a11y/label-has-associated-control": "off",
        // Off: `role="status"` on a `<p>` or `role="dialog"` on a `<div>` is
        // correct ARIA; swapping the element is a style call, not a barrier.
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/.astro/**",
    "**/.wrangler/**",
    "**/node_modules/**",
    "**/preview/**",
    "**/*.md",
    "**/*.mdx"
  ]
}
